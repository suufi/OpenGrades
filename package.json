    "html-entities": "^2.3.3",
    "infer-next-props-type": "^0.0.4",
    "jsonwebtoken": "^9.0.3",
    "mantine-datatable": "^9.0.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "minio": "^8.0.7",
